{
  "name": "castinglots",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modern casting lots site using local LEB Bible data.",
  "homepage": "https://joshualinog.github.io/castinglots/",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshualinog/castinglots.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p docs/js && cp -R js/leb docs/js/leb && cp CNAME docs/CNAME",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.0",
    "vite": "^5.4.2"
  }
}
