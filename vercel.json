{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "docs"
      }
    },
    {
      "src": "api/random.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/random$",
      "dest": "/api/random.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ]
}
